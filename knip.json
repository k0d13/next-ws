{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@favware/npm-deprecate"],
  "ignoreIssues": {
    "src/server/persistent.ts": ["exports"]
  },
  "workspaces": {
    ".": {},
    "examples/*": {},
    "tests/integration": {
      "entry": [
        "fixtures/*/server.mjs",
        "fixtures/*/instrumentation.js",
        "fixtures/*/next.config.mjs",
        "fixtures/*/app/**/route.js"
      ]
    }
  }
}
