{
  "name": "next-ws",
  "version": "2.2.19",
  "description": "Add support for WebSockets in the Next.js app directory",
  "keywords": [
    "client",
    "next",
    "server",
    "websocket",
    "ws"
  ],
  "homepage": "https://github.com/k0d13/next-ws#readme",
  "bugs": {
    "url": "https://github.com/k0d13/next-ws/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k0d13/next-ws.git"
  },
  "bin": {
    "next-ws": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.cts",
      "default": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.cts",
      "default": "./dist/server/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "change": "changeset",
    "check": "pnpm run check:types && pnpm run check:lint && pnpm run check:format && pnpm run check:deps",
    "check:deps": "knip",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --deny-warnings",
    "check:types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix --deny-warnings",
    "prepare": "lefthook install && tsdown",
    "release:publish": "pnpm build && changeset publish",
    "release:snapshot:publish": "pnpm build && changeset publish --tag beta --no-git-tag",
    "release:snapshot:version": "changeset version --snapshot beta",
    "release:version": "changeset version",
    "test": "playwright test"
  },
  "dependencies": {
    "jscodeshift": "^17.3.0",
    "minimist": "^1.2.8",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "@favware/npm-deprecate": "^2.0.0",
    "@playwright/test": "^1.58.2",
    "@types/jscodeshift": "^17.3.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.19.2",
    "@types/react": "catalog:",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "chalk": "^5.6.2",
    "ioredis": "catalog:",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "next": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "next": ">=13.5.1",
    "react": "*",
    "ws": "*"
  },
  "packageManager": "pnpm@11.28.6"
}
